DATABASE_URL="postgresql://user:password@localhost:5432/neuron_sentinel?schema=public"
JWT_SECRET=
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# WeatherProvider — vide = mode MOCK (voir src/services/weatherService.js)
WEATHER_API_KEY=

# SatelliteProvider — vide = mode MOCK (voir src/services/satelliteService.js)
SATELLITE_API_KEY=

# SMSProvider — MOCK par défaut tant qu'un vrai fournisseur n'est pas configuré
SMS_PROVIDER=MOCK
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=NeuronSentinel

# AIProvider — vide = modèle MOCK déterministe (voir src/services/aiService.js)
AI_API_URL=
